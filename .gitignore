# Built place files (rebuild with `rojo build`)
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
!assets/**/*.rbxm

# Studio lock/backup files
*.rbxl.lock
*.rbxlx.lock

# Blender backups
*.blend1

# Packages / tooling
Packages/
sourcemap.json

# OS
.DS_Store
Thumbs.db

# Python caches (from the Blender scripts)
__pycache__/
*.pyc

# Layout check picture
tools/layout/map.png
tools/layout/dump.txt
tools/devices/out/
tools/devices/out.txt
tools/photo/out/
tools/photo/out.txt

# Bought packs (proprietary: their licenses forbid any repository). Rebuild with tools/vendor_packs.luau
vendor/

# KayKit exports and pictures (rebuild with tools/import/kaykit.py; only the size lists are kept)
art/export/kaykit/**
!art/export/kaykit/*/
!art/export/kaykit/*/manifest.csv
