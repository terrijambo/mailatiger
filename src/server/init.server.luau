--!strict
-- Server entry point. Runs once when a server starts.
-- Server scripts own the truth: coins, boxing progress, payouts, saves. Players can't tamper with them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Analytics = require(script.Analytics)
local BoxingService = require(script.BoxingService)
local ChallengeService = require(script.ChallengeService)
local CodesService = require(script.CodesService)
local DataService = require(script.DataService)
local Economy = require(script.Economy)
local DiveService = require(script.DiveService)
local EggService = require(script.EggService)
local EventService = require(script.EventService)
local InviteService = require(script.InviteService)
local LeaderboardService = require(script.LeaderboardService)
local MachineService = require(script.MachineService)
local Look = require(script.Look)
local MailService = require(script.MailService)
local MapBuilder = require(script.MapBuilder)
local MonetizationService = require(script.MonetizationService)
local PaycheckService = require(script.PaycheckService)
local ProgressionService = require(script.ProgressionService)
local ShopService = require(script.ShopService)
local StreakService = require(script.StreakService)
local Travel = require(script.Travel)
local TrollService = require(script.TrollService)
local TutorialService = require(script.TutorialService)
local WelcomeService = require(script.WelcomeService)
local WildService = require(script.WildService)

Look.Apply()
local map = MapBuilder.Build()
Travel.Start(map)

-- Everything that listens for "a player's save finished loading" connects first...
Analytics.Start()
Economy.Start()
ShopService.Start(map)
DiveService.Start()
BoxingService.Start(map)
WildService.Start(map) -- (wild animals in every zone; after BoxingService, which runs the jobs)
MailService.Start(map)
MachineService.Start(map)
EggService.Start()
TutorialService.Start()
CodesService.Start()
MonetizationService.Start()
PaycheckService.Start()
WelcomeService.Start()
ProgressionService.Start()
TrollService.Start()
ChallengeService.Start()
StreakService.Start()
EventService.Start(map)
InviteService.Start() -- (after EventService: it adds onto the same mailed hook)
-- ...then we start loading saves.
DataService.Start()
-- Leaderboards need to know whether DataStores work, so they start last.
LeaderboardService.Start(map)

print(`[Mail Animals!] Server started. {#Config.Animals.List} animals loaded.`)
